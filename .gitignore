*.xcuserstate
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Java/Maven
target/
*.jar
*.war
*.class
.settings/
.project
.classpath

# IntelliJ IDEA (keep .idea/.gitignore for project-specific)
.idea/
*.iml
.obsidian/
.opencode/
.trae/
**/.drafts/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Docker
docker/.env

# Logs
*.log
logs/

# Environment
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.env.production
.env.development
