storybook-static/

# Temporary files
*.tmp
*.temp
.cache/
.drawio-tmp/
tmp/
temp/
.git-versions/

# Claude / agent skills (ignore local settings, keep shared skills)
.claude/*
!.claude/skills/
!.claude/skills/**
.agents/*
!.agents/skills/
!.agents/skills/**

# Documentation generated files
docs/CODEMAPS/

# Axhub Make client — project-specific (Axhub原型设计/.gitignore is the source of truth)
# vendor dist is tracked; general dist/ ignored above
Axhub原型设计/!vendor/**/dist/
Axhub原型设计/!vendor/**/dist/**

# Runtime-generated local config
.axhub/make/*
!.axhub/make/client.json
!.axhub/make/axhub.config.json
!.axhub/make/README.md
!.axhub/make/sidebar-tree.json
.axhub/sessions/
Axhub原型设计/components.json
Axhub原型设计/.dev-server-info.json
Axhub原型设计/entries.json

# Large source fonts kept outside the published client template
src/prototypes/beginner-guide/TsangerJinKai02-W04.ttf
src/prototypes/beginner-guide/TsangerJinKai02-W05.ttf

# ACP sidebar cache and local review artifacts — do not commit or export
src/prototypes/**/.spec/acp/
src/prototypes/**/.spec/prototype-comments.json
