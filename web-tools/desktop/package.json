{
  "name": "nexus-tools-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "tdragon8113",
  "description": "Nexus Tools desktop shell (uTools-style launcher)",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "npm run build && cross-env NEXUS_WEB_DEV=1 electron .",
    "dev:3001": "npm run build && cross-env NEXUS_WEB_DEV=1 NEXUS_WEB_URL=http://127.0.0.1:3001 electron .",
    "start": "electron .",
    "pack": "npm run icons && npm run build && electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.nexus.tools",
    "productName": "Nexus Tools",
    "publish": {
      "provider": "github",
      "owner": "tdragon8113",
      "repo": "nexus-tools"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/tray-icon.svg",
      "icons/trayTemplate.png",
      "icons/trayTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "../.output/public",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "icons/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "NexusTools.${ext}",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NexusTools-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
