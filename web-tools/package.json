{
  "name": "nexus-web-tools",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:desktop": "npm run dev & npm run desktop:dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "desktop:install": "npm install --prefix desktop",
    "desktop:build": "npm run build --prefix desktop",
    "desktop:dev": "npm run dev --prefix desktop",
    "desktop:start": "npm run generate && npm run build --prefix desktop && npm run start --prefix desktop",
    "desktop:dist": "npm run generate && npm run dist:mac --prefix desktop",
    "desktop:dist:mac": "npm run generate && npm run dist:mac --prefix desktop",
    "desktop:dist:win": "npm run generate && npm run dist:win --prefix desktop"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.6",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@vant/nuxt": "^1.0.7",
    "codemirror": "^6.0.2",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "markdown-it": "^14.2.0",
    "nuxt": "^4.4.2",
    "pinyin-pro": "^3.28.1",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "vant": "^4.9.24",
    "vue": "^3.5.32",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6"
  }
}
