<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nexus.user.infrastructure.persistence.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.nexus.user.domain.model.User">
        <id column="id" property="idValue"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatarUrl"/>
        <result column="status" property="statusFromCode"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="findUserByPk" resultMap="UserResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <insert id="insertUser" useGeneratedKeys="true" keyProperty="idValue">
        INSERT INTO users (username, email, password, nickname, avatar, status, created_at, updated_at)
        VALUES (
            #{username},
            #{email},
            #{password},
            #{nickname},
            #{avatarUrl},
            #{statusCode},
            COALESCE(#{createdAt}, NOW()),
            COALESCE(#{updatedAt}, NOW())
        )
    </insert>

    <update id="updateUser">
        UPDATE users
        SET username = #{username},
            email = #{email},
            password = #{password},
            nickname = #{nickname},
            avatar = #{avatarUrl},
            status = #{statusCode},
            updated_at = COALESCE(#{updatedAt}, NOW())
        WHERE id = #{idValue}
    </update>
</mapper>